generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline             Boolean   @default(false)
  scope                String?
  expires              DateTime?
  accessToken          String
  userId               BigInt?
  firstName            String?
  lastName             String?
  email                String?
  accountOwner         Boolean   @default(false)
  locale               String?
  collaborator         Boolean?  @default(false)
  emailVerified        Boolean?  @default(false)
  refreshToken         String?
  refreshTokenExpires  DateTime?
}

model Manager {
  id                   String   @id @default(cuid())
  shop                 String
  name                 String
  email                String

  // General notification switch
  notificationsEnabled Boolean  @default(true)

  // Individual notification preferences
  orderNotifications       Boolean @default(true)
  customerNotifications    Boolean @default(true)
  newsletterNotifications  Boolean @default(true)
  productNotifications     Boolean @default(true)
  contactNotifications     Boolean @default(true)

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([shop, email])
}

model NotificationHistory {
  id              String   @id @default(cuid())

  shop            String

  notificationType String
  resourceId       String?
  resourceName     String?

  managerId        String?
  managerEmail     String?

  status           String   @default("sent")
  errorMessage     String?

  createdAt        DateTime @default(now())

  @@index([shop])
  @@index([shop, notificationType])
  @@index([shop, createdAt])
}